rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuth()  { return request.auth != null; }
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    // Products: publicly readable (e-commerce browsing without login)
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }

    // Users: only owner or admin can read/write individual docs; no public listing
    match /users/{uid}     { allow read, write: if isOwner(uid) || isAdmin(); }

    // Carts & Wishlists: only owner access
    match /carts/{uid}     { allow read, write: if isOwner(uid); }
    match /wishlists/{uid} { allow read, write: if isOwner(uid); }

    // Orders: admin can read/write all; users can only access their own orders
    match /orders/{id}     {
      allow read: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // Reviews: publicly readable (social proof for anonymous visitors)
    match /reviews/{id}    { allow read: if true; allow create: if isAuth(); allow update, delete: if isAdmin(); }

    // Settings: publicStats doc is world-readable for homepage stats; other docs require auth
    match /settings/{id}   { allow read: if id == 'publicStats' || isAuth(); allow write: if isAdmin(); }

    // Newsletter: authenticated users can subscribe, only admins can manage
    match /newsletter/{id} { allow create: if isAuth(); allow read, update, delete: if isAdmin(); }

    // Analytics: authenticated users can CREATE events, only admins can read or modify them
    match /analytics/{id}  { allow create: if isAuth(); allow read, update, delete: if isAdmin(); }
  }
}
